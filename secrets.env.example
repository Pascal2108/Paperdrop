# Copy to secrets.env and fill in. secrets.env is git-ignored – never commit it.
# Wrap a value in 'single quotes' if it contains $ or #.

# Paperless token: profile (top right) -> "API Auth Token" -> generate/copy
PAPERLESS_TOKEN=your-token-here

# Login for the upload page
UPLOADER_USER=your-username
UPLOADER_PASSWORD=a-long-secure-password

# Random key that signs the login form, generate with:
#   openssl rand -hex 32
SECRET_KEY=paste-random-key-here
